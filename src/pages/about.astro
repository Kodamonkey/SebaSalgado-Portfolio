---
import AboutHero from "@/components/about/AboutHero.astro";
import FutureDirection from "@/components/about/FutureDirection.astro";
import HobbyGrid from "@/components/about/HobbyGrid.astro";
import InterestMap from "@/components/about/InterestMap.astro";
import PrincipleGrid from "@/components/about/PrincipleGrid.astro";
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import { aboutPage } from "@/data/about";
import { profile } from "@/data/profile";
---

<Layout
  title={`${aboutPage.hero.title} | ${profile.displayName}`}
  description="A concise personal profile about curiosity, interests, principles and long-term direction near AI, science and systems."
>
  <main class="px-4">
    <SectionContainer id="about-page" class="pb-24 pt-32 md:pb-32 md:pt-44">
      <AboutHero />
    </SectionContainer>

    <div class="space-y-24">
      <SectionContainer id="drives">
        <section class="rounded-lg border border-black/10 bg-white/75 p-6 shadow-sm dark:border-white/10 dark:bg-gray-900/75">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
            What drives me
          </h2>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {
              aboutPage.drivers.map((driver) => (
                <p class="rounded-lg bg-gray-50 p-4 leading-7 text-gray-700 dark:bg-gray-800/80 dark:text-gray-300">
                  {driver}
                </p>
              ))
            }
          </div>
        </section>
      </SectionContainer>

      <SectionContainer id="interests">
        <InterestMap />
      </SectionContainer>

      <SectionContainer id="thinking">
        <PrincipleGrid />
      </SectionContainer>

      <SectionContainer id="outside">
        <HobbyGrid />
      </SectionContainer>

      <SectionContainer id="direction">
        <FutureDirection />
      </SectionContainer>
    </div>
  </main>
</Layout>
