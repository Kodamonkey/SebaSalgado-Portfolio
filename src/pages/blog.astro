---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import { profile } from "@/data/profile";
---

<Layout
  title={`Notes | ${profile.displayName}`}
  description="Technical notes and writing space for AI engineering, scientific computing, and research software engineering."
>
  <SectionContainer id="notes" class="py-32">
    <article
      class="rounded-lg border border-black/10 bg-white/70 p-6 shadow-sm dark:border-white/10 dark:bg-gray-900/70"
    >
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
        Technical Notes
      </h1>
      <p class="mt-4 max-w-2xl leading-7 text-gray-700 dark:text-gray-300">
        This route is reserved for future writing on AI engineering, scientific
        computing, research software engineering, and radio astronomy workflows.
      </p>
    </article>
  </SectionContainer>
</Layout>
