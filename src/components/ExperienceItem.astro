---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
  location?: string;
  details?: string[];
  keywords?: string[];
}

const {
  title,
  company,
  description,
  link,
  date,
  location,
  details = [],
  keywords = [],
} = Astro.props;
---

<div
  class="relative mx-12 grid pb-12 before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 before:content-[''] dark:before:border-white/15 md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="absolute -left-[43px] rounded-full text-5xl text-blue-400"
        >&bull;</span
      >
      <h3 class="text-xl font-bold text-cyan-900 dark:text-cyan-100">{title}</h3>
      <h4 class="text-xl font-semibold text-gray-600 dark:text-white">
        {company}
      </h4>
      <time class="m-0 p-0 text-sm text-gray-600/80 dark:text-white/80">
        {date}
      </time>
      {
        location && (
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            {location}
          </p>
        )
      }
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3"
  >
    <p>{description}</p>
    {
      details.length > 0 && (
        <ul class="mt-2 list-disc space-y-1 pl-5">
          {details.map((detail) => (
            <li>{detail}</li>
          ))}
        </ul>
      )
    }
    {
      link && (
        <LinkInline href={link}>
          Learn more{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
    {
      keywords.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${title} keywords`}>
          {keywords.slice(0, 5).map((keyword) => (
            <li class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
              {keyword}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
