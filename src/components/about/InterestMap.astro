---
import { aboutPage } from "@/data/about";
---

<section>
  <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
    Things I care about
  </h2>
  <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      aboutPage.interestClusters.map((cluster) => (
        <article class="rounded-lg border border-black/10 bg-white/75 p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-white/10 dark:bg-gray-900/75">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">
            {cluster.title}
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {cluster.items.map((item) => (
              <li class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
