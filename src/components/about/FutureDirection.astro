---
import LinkButton from "@/components/LinkButton.astro";
import { aboutPage } from "@/data/about";
---

<section class="rounded-lg border border-black/10 bg-white/75 p-6 shadow-sm dark:border-white/10 dark:bg-gray-900/75">
  <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
    Where I want to go next
  </h2>
  <p class="mt-5 max-w-2xl leading-8 text-gray-700 dark:text-gray-300">
    Long term, I want to work closer to research environments where software,
    AI and science meet.
  </p>
  <ul class="mt-6 flex flex-wrap gap-2">
    {
      aboutPage.futureDirections.map((direction) => (
        <li class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-900 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-100">
          {direction}
        </li>
      ))
    }
  </ul>
  <div class="mt-8 flex flex-wrap gap-3">
    <LinkButton href="/#projects">View projects</LinkButton>
    <LinkButton href="/#contact">Contact</LinkButton>
  </div>
</section>
