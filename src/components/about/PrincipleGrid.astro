---
import { aboutPage } from "@/data/about";
---

<section>
  <h2 class="text-3xl font-bold text-gray-900 dark:text-white">How I think</h2>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {
      aboutPage.principles.map((principle) => (
        <article class="rounded-lg border border-black/10 bg-white/75 p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:border-white/10 dark:bg-gray-900/75">
          <h3 class="text-lg font-bold text-gray-900 dark:text-white">
            {principle.title}
          </h3>
          <p class="mt-3 leading-7 text-gray-700 dark:text-gray-300">
            {principle.body}
          </p>
        </article>
      ))
    }
  </div>
</section>
