---
import { education } from "@/data/education";
---

<div class="grid gap-5">
  {
    education.map((entry) => (
      <article class="rounded-lg border border-black/10 bg-white/70 p-5 shadow-sm dark:border-white/10 dark:bg-gray-900/70">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">
              {entry.title}
            </h3>
            <p class="font-semibold text-cyan-900 dark:text-cyan-100">
              {entry.institution}
            </p>
          </div>
          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">
            {entry.date}
          </p>
        </div>
        <p class="mt-4 leading-7 text-gray-700 dark:text-gray-300">
          {entry.description}
        </p>
      </article>
    ))
  }
</div>
