---
import { navigationItems } from "@/data/profile";
---

<header
  class="fixed top-5 z-20 flex w-full items-center justify-center px-4 md:top-6"
>
  <button
    class="ml-auto block rounded-full bg-white/80 p-2 text-gray-900 shadow-sm dark:bg-gray-800/90 dark:text-white md:hidden"
    id="hamburgerButton"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="dropdownMenu"
  >
    <svg
      class="h-6 w-6"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16m-7 6h7"></path>
    </svg>
  </button>

  <nav
    id="navLinks"
    class="hidden items-center justify-center rounded-full bg-white/80 px-4 py-1 font-medium text-gray-900 shadow-sm backdrop-blur dark:bg-gray-800/90 dark:text-white md:flex"
    aria-label="Primary navigation"
  >
    {
      navigationItems.map((item) => (
        <a
          class="relative flex items-center justify-center px-5 py-3 text-sm transition hover:text-blue-600 dark:hover:text-blue-300"
          aria-label={item.label}
          href={item.href}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <nav
    class="absolute right-4 top-0 z-20 mt-12 hidden w-3/4 max-w-xs rounded-lg bg-white p-4 shadow-lg transition-transform duration-300 dark:bg-gray-800 md:hidden"
    id="dropdownMenu"
    aria-label="Mobile navigation"
  >
    {
      navigationItems.map((item) => (
        <a
          href={item.href}
          class="block px-5 py-3 text-gray-900 dark:text-gray-300"
          data-mobile-nav-link
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const hamburgerButton = document.getElementById("hamburgerButton");
    const dropdownMenu = document.getElementById("dropdownMenu");
    const mobileLinks = document.querySelectorAll("[data-mobile-nav-link]");

    const closeDropdown = () => {
      dropdownMenu?.classList.add("hidden");
      hamburgerButton?.setAttribute("aria-expanded", "false");
    };

    const toggleDropdown = (event: Event) => {
      dropdownMenu?.classList.toggle("hidden");
      const isOpen = dropdownMenu && !dropdownMenu.classList.contains("hidden");
      hamburgerButton?.setAttribute("aria-expanded", String(Boolean(isOpen)));
      event.stopPropagation();
    };

    hamburgerButton?.addEventListener("click", toggleDropdown);
    mobileLinks.forEach((link) => link.addEventListener("click", closeDropdown));

    document.addEventListener("click", (event: MouseEvent) => {
      const target = event.target as Node;
      if (
        dropdownMenu &&
        hamburgerButton &&
        !dropdownMenu.classList.contains("hidden") &&
        target !== dropdownMenu &&
        target !== hamburgerButton &&
        !dropdownMenu.contains(target)
      ) {
        closeDropdown();
      }
    });
  });
</script>

<style>
  #dropdownMenu {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
