---
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import { projects } from "@/data/projects";
---

<div class="flex flex-col gap-y-24">
  {
    projects.map(
      ({
        image,
        imageAlt,
        title,
        type,
        description,
        technologies,
        link,
        github,
        featured,
      }) => (
        <article class="group grid gap-8 md:grid-cols-2 md:items-start">
          <div class="w-full">
            <div class="relative flex min-h-56 flex-col justify-between gap-8 overflow-hidden rounded-lg border border-gray-200 bg-white/70 p-6 shadow-xl transition duration-500 ease-in-out dark:border-gray-800 dark:bg-gray-900/70 md:group-hover:-translate-y-1 md:group-hover:shadow-2xl">
              {image ? (
                <img
                  class="h-56 w-full rounded-md object-cover object-top"
                  loading="lazy"
                  src={image}
                  alt={imageAlt ?? `${title} project preview`}
                />
              ) : (
                <div class="flex min-h-48 flex-col justify-between rounded-md bg-gray-950 p-6 text-white">
                  <span class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-200">
                    {featured ? "Featured research system" : "Project"}
                  </span>
                  <p class="mt-10 text-2xl font-bold leading-tight">{title}</p>
                  <p class="mt-3 text-sm text-gray-300">{type}</p>
                </div>
              )}
            </div>
          </div>

          <div class="w-full md:max-w-lg">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
              {title}
            </h3>
            <p class="mt-2 text-sm font-semibold uppercase tracking-[0.14em] text-blue-700 dark:text-blue-300">
              {type}
            </p>
            <div class="mt-4 flex flex-wrap">
              <ul class="mb-3 flex flex-wrap gap-2">
                {technologies.map((technology) => (
                  <li>
                    <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                      {technology}
                    </span>
                  </li>
                ))}
              </ul>

              <p class="mt-2 text-gray-700 dark:text-gray-400">{description}</p>
              <footer class="mt-4 flex items-end justify-start gap-x-4">
                {github && (
                  <LinkButton
                    href={github}
                    aria-label={`View ${title} on GitHub`}
                  >
                    <GitHub class="size-6" />
                    GitHub
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link} aria-label={`Open ${title} preview`}>
                    <Link class="size-4" />
                    Preview
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      ),
    )
  }
</div>
