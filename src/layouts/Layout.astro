---
import "@fontsource-variable/onest";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import { profile } from "@/data/profile";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { description, title, image = profile.seo.image } = Astro.props;
const site = Astro.site ?? new URL(profile.seo.url);
const canonicalUrl = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/s.png" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="relative overflow-x-hidden text-black dark:text-white">
    <div
      class="absolute bottom-0 top-0 z-[-2] min-h-screen w-full bg-gray-800 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(255,255,255,0.9),rgba(255,255,255,0.9))] dark:bg-gray-950 dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <main class="container mx-auto max-w-full flex-grow px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
    <style is:global>
      :root {
        color-scheme: light dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
        overflow-x: hidden;
      }

      .container {
        max-width: 1200px;
        width: 100%;
        overflow-x: hidden;
      }

      img,
      .container img,
      .profile-image-container img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      @media (max-width: 768px) {
        .container {
          max-width: 100%;
        }

        #header-nav,
        .profile-image-container {
          padding: 0 1rem;
          max-width: 100%;
        }
      }
    </style>
  </body>
</html>
